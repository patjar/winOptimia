<Window x:Class="EPFOptimizerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EPF Optimizer Pro Premium IA v3.7.3" Height="940" Width="1320" MinHeight="860" MinWidth="1180"
        WindowStartupLocation="CenterScreen" Background="#020617" FontFamily="Segoe UI">
    <Window.Resources>
        <LinearGradientBrush x:Key="PageGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#020617" Offset="0"/>
            <GradientStop Color="#0F172A" Offset="0.55"/>
            <GradientStop Color="#111827" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextMain" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Sky" Color="#38BDF8"/>
        <SolidColorBrush x:Key="Green" Color="#22C55E"/>
        <SolidColorBrush x:Key="Panel" Color="#111827"/>
        <SolidColorBrush x:Key="BorderPremium" Color="#26364F"/>
        <SolidColorBrush x:Key="ButtonIdle" Color="#2563EB"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderPremium}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Effect">
                <Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.24" Color="#000000"/></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Background" Value="{StaticResource ButtonIdle}"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="15" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.70"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Foreground" Value="#22C55E"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#050A16"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="BorderBrush" Value="#26364F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageGradient}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="235"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="390"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="EPF Optimizer Pro" FontSize="15" Foreground="{StaticResource Sky}" FontWeight="SemiBold"/>
                    <TextBlock Text="Adaptive Task Engine v3.7.3" FontSize="34" FontWeight="Bold" Margin="0,2,0,4"/>
                    <TextBlock Text="Dashboard fluide : mises à jour UI limitées, tâches actives visibles et terminées en mini-icônes." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="108" Height="108" CornerRadius="54" BorderBrush="#38BDF8" BorderThickness="3" Background="#07111F" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtScoreHero" Text="100" FontSize="32" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center"/>
                            <TextBlock Text="/100" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtClock" Text="◐ 00:00:00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Sky}"/>
                        <TextBlock x:Name="TxtMetrics" Text="CPU -- % | RAM -- %" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                        <TextBlock x:Name="TxtEvents" Text="0 événement" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="TxtWorkers" Text="Workers : --" Foreground="{StaticResource Green}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUpdateStatus" Text="Mise à jour : non vérifiée" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtStep" Text="Prêt" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtPercent" Grid.Column="1" Text="0 %" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Sky}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressGlobal" Minimum="0" Maximum="100" Value="0" Height="18" Margin="0,12,0,14"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button x:Name="BtnAudit" Content="Audit seul" MinWidth="128" Click="BtnAudit_Click"/>
                        <Button x:Name="BtnOptimize" Content="Optimiser" MinWidth="128" Click="BtnOptimize_Click"/>
                        <Button x:Name="BtnCancel" Content="Annuler" MinWidth="128" Click="BtnCancel_Click"/>
                        <Button x:Name="BtnOpenReport" Content="Rapport" MinWidth="128" Click="BtnOpenReport_Click"/>
                        <Button x:Name="BtnOpenLearning" Content="Mémoire IA" MinWidth="128" Click="BtnOpenLearning_Click"/>
                        <Button x:Name="BtnCheckUpdate" Content="Mise à jour" MinWidth="128" Click="BtnCheckUpdate_Click"/>
                        <Button x:Name="BtnDownloadUpdate" Content="Télécharger update" MinWidth="150" IsEnabled="False" Click="BtnDownloadUpdate_Click"/>
                        <Button x:Name="BtnOpenUpdateRelease" Content="Release GitHub" MinWidth="128" IsEnabled="False" Click="BtnOpenUpdateRelease_Click"/>
                        <Button x:Name="BtnExit" Content="Fermer" MinWidth="110" Click="BtnExit_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtActionHint" Text="Le nombre de tâches simultanées s’adapte automatiquement au CPU et à la RAM." Foreground="{StaticResource TextMuted}" FontSize="12"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtCpuCard" Text="-- %" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Sky}" Margin="0,4,0,6"/>
                    <ProgressBar x:Name="ProgressCpuMini" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock Text="Charge actuelle" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="RAM" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtRamCard" Text="-- %" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Green}" Margin="0,4,0,6"/>
                    <ProgressBar x:Name="ProgressRamMini" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock Text="Mémoire utilisée" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Tâches actives" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Sky}"/>
                    <TextBlock x:Name="TxtDashboardSummary" Text="  |  actives + terminées" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,6,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Top" Background="#050A16" BorderBrush="#26364F" BorderThickness="1" CornerRadius="14" Padding="8" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Terminées" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <ItemsControl x:Name="CompletedTasksItems">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0B1220" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="10" Padding="6,4" Margin="0,0,7,0" ToolTip="{Binding Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#E5E7EB"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ActiveTasksItems">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#050A16" BorderBrush="#26364F" BorderThickness="1" CornerRadius="16" Width="220" Height="86" Padding="9" Margin="0,0,9,9">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" Foreground="{Binding StatusColor}" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10" Margin="0,2,0,3"/>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="7"/>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextMuted}" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" Height="22"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Assistant IA" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Sky}"/>
                        <TextBlock Text="Analyse locale basée sur l’historique et les tâches." Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    </StackPanel>
                    <TextBox x:Name="TxtAi" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Journal temps réel" Foreground="{StaticResource Sky}" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBox x:Name="TxtLog" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>


